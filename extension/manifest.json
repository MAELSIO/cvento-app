{
  "manifest_version": 3,
  "name": "CVento — Remplissage auto de candidatures",
  "version": "1.0.0",
  "description": "Pré-remplit vos informations (nom, email, téléphone, ville...) sur les formulaires de candidature, à partir de votre profil CVento.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"]
}
